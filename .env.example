# --- Server ---
PORT=2002

# --- Kafka ---
# local = plaintext Docker; aiven = SASL_SSL (set KAFKA_MODE=aiven + SASL/CA vars)
KAFKA_MODE=local
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=your-aiven-username
KAFKA_SASL_PASSWORD=your-aiven-password
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SSL_CA_PATH=./ca.pem
KAFKA_SSL_CA=

# --- Elasticsearch ---
ELASTIC_SEARCH_SERVER_URL='http://localhost:9200'

# --- Auth / JWT ---
ACCESS_TOKEN_SECRET=your-access-token-secret

# --- Database ---
DATABASE_URL="mysql://user:password@localhost:3306/your-db-name"

# --- Admin ---
ADMIN_TOKEN_SECRET=your-admin-token-secret

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
